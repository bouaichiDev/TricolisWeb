APP_NAME="Tricolis Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CUSTOMER_PORTAL_URL=http://localhost:5180
PROVIDER_PORTAL_URL=http://localhost:5190

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tricolisweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La file passe par la base : `php artisan queue:work` est requis pour les
# communications, et `php artisan schedule:work` pour celles qui sont programmees.
QUEUE_CONNECTION=database
# Doit dépasser le plus long `$timeout` de job (import portail : 1800 s),
# sinon un job encore en cours est repris une seconde fois.
# Voir docs/deployment/customer-portal-queue.md.
DB_QUEUE_RETRY_AFTER=1900

# Origines CORS autorisées, séparées par des virgules : back-office ET portail
# client de production. Les origines localhost ne sont ajoutées que hors production.
CORS_ALLOWED_ORIGINS=https://tricolis.bouaichibadr.com

CACHE_STORE=database
# CACHE_PREFIX=



MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Technical administrators allowed to inspect application logs.
LOG_VIEWER_ENABLED=false
LOG_VIEWER_ALLOWED_EMAILS=

# --- Portail client -------------------------------------------------------
# CUSTOMER_PORTAL_URL (en tête de fichier) : adresse publique du portail pour
# les liens d'invitation, de réinitialisation et de suivi public. OBLIGATOIRE
# en production.
# Seulement si le suivi public est servi ailleurs que le portail ; laisser
# commentée sinon (une valeur vide casserait les liens).
# CUSTOMER_PORTAL_TRACKING_URL=
# Les variables suivantes ont un défaut technique sûr ; voir
# docs/customer-portal/security.md (§11) et docs/deployment/.
CUSTOMER_PORTAL_INVITATION_HOURS=72
CUSTOMER_PORTAL_TOKEN_TTL_MINUTES=720
CUSTOMER_PORTAL_RATE_LIMIT=300
CUSTOMER_PORTAL_LOGIN_RATE_LIMIT=30
CUSTOMER_PORTAL_IMPORT_RATE_LIMIT=10
CUSTOMER_PORTAL_RETRY_RATE_LIMIT=10
CUSTOMER_PORTAL_TRACKING_REFRESH=45
CUSTOMER_PORTAL_POSITION_CACHE=30
CUSTOMER_PORTAL_CALENDAR_MAX_DAYS=100
CUSTOMER_PORTAL_CALENDAR_MAX_EVENTS=500
PUBLIC_TRACKING_RATE_LIMIT=60
PUBLIC_TRACKING_CACHE_SECONDS=15
DOCUMENT_RETENTION_DAYS=30

# --- Portail fournisseur --------------------------------------------------
# PROVIDER_PORTAL_URL (en tête de fichier) : adresse publique du portail
# fournisseur, utilisée dans les liens d’activation et de réinitialisation.
PROVIDER_PORTAL_INVITATION_HOURS=72
PROVIDER_PORTAL_TOKEN_TTL_MINUTES=720
PROVIDER_PORTAL_RATE_LIMIT=300
PROVIDER_PORTAL_LOGIN_RATE_LIMIT=30

# --- Intégrations client --------------------------------------------------
CUSTOMER_API_RATE_LIMIT_PER_MINUTE=60
CUSTOMER_API_FAILED_ATTEMPTS_PER_MINUTE=10
CUSTOMER_INTEGRATIONS_MAX_FILE_KB=5120
CUSTOMER_INTEGRATIONS_MAX_ROWS=5000
CUSTOMER_INTEGRATIONS_MAX_RESPONSE_KB=5120
CUSTOMER_INTEGRATIONS_SYNC_ORDER_LIMIT=200
# Jamais `array` : jetons d'import et verrous d'idempotence partagés entre processus.
CUSTOMER_INTEGRATIONS_CACHE_STORE=database
# Hôtes internes explicitement autorisés pour les intégrations (virgules). Vide = aucun.
CUSTOMER_INTEGRATIONS_ALLOWED_PRIVATE_HOSTS=
# Les connexions FTP/SFTP de relève se règlent dans le back-office (mot de
# passe chiffré en base) : plus de variable d'environnement depuis la Phase 8.
